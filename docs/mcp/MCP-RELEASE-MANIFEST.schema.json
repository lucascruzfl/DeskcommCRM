{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeskcommCRM MCP release",
  "type": "object",
  "required": ["schema_version", "deskcomm_version", "tag", "mcp_commit", "tests", "gaps_a", "tool_count_snapshot", "images"],
  "properties": {
    "schema_version": { "const": 1 },
    "deskcomm_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+-mcp$" },
    "mcp_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "tests": { "const": "passed" },
    "gaps_a": { "const": 0 },
    "tool_count_snapshot": { "type": "integer", "minimum": 1 },
    "images": {
      "type": "object",
      "required": ["app", "worker", "scheduler", "voice_agent"],
      "properties": {
        "app": { "$ref": "#/$defs/image" },
        "worker": { "$ref": "#/$defs/image" },
        "scheduler": { "$ref": "#/$defs/image" },
        "voice_agent": { "$ref": "#/$defs/image" }
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest"],
      "properties": {
        "repository": { "type": "string", "pattern": "^ghcr\\.io/[a-z0-9._-]+/[a-z0-9._-]+$" },
        "tag": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-mcp$" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
